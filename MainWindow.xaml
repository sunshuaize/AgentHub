<Window x:Class="AgentHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentHub - MCP &amp; Skills Viewer" 
        Height="750" Width="1400"
        MinHeight="550" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="#F0F0F0"
        WindowStyle="None">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" 
                      ResizeBorderThickness="6" 
                      GlassFrameThickness="0" 
                      CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ============ Window Control Button Style ============ -->
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ============ Color Palette ============ -->
        <Color x:Key="PrimaryColor">#6467F2</Color>
        <Color x:Key="PrimaryHover">#818CF8</Color>
        <Color x:Key="PrimaryBgLight">#EEF2FF</Color>
        <Color x:Key="PrimaryBgSubtle">#F0EEFF</Color>
        <Color x:Key="HeaderBg">#1E1E2E</Color>
        <Color x:Key="SidebarBg">#FAFAFA</Color>
        <Color x:Key="BorderColor">#E2E2E8</Color>
        <Color x:Key="TextDark">#1E1E2E</Color>
        <Color x:Key="TextMedium">#64748B</Color>
        <Color x:Key="TextLight">#94A3B8</Color>
        <Color x:Key="CardBg">#F8FAFC</Color>
        <Color x:Key="SuccessGreen">#16A34A</Color>
        <Color x:Key="SuccessBg">#DCFCE7</Color>
        <Color x:Key="DangerRed">#DC2626</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHover}"/>
        <SolidColorBrush x:Key="PrimaryBgBrush" Color="{StaticResource PrimaryBgLight}"/>
        <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
        <SolidColorBrush x:Key="TextDarkBrush" Color="{StaticResource TextDark}"/>
        <SolidColorBrush x:Key="TextMediumBrush" Color="{StaticResource TextMedium}"/>
        <SolidColorBrush x:Key="TextLightBrush" Color="{StaticResource TextLight}"/>

        <!-- ============ Primary (Filled) Button ============ -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Danger Button ============ -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value><SolidColorBrush Color="#FEF2F2"/></Setter.Value>
            </Setter>
            <Setter Property="Foreground">
                <Setter.Value><SolidColorBrush Color="{StaticResource DangerRed}"/></Setter.Value>
            </Setter>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="#FDE2E2" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="#FEE2E2"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Dashed Add Button (Stitch style) ============ -->
        <Style x:Key="DashedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="8" Padding="{TemplateBinding Padding}"
                                BorderBrush="#CBD5E1" BorderThickness="2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <!-- WPF doesn't support dashed borders natively, using solid -->
                                </Style>
                            </Border.Style>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Editor ListBoxItem ============ -->
        <Style x:Key="EditorListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="8" Margin="0,1" Padding="10,8"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="#F1F5F9"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background">
                                    <Setter.Value><SolidColorBrush Color="#EEF2FF"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="bd" Property="BorderBrush">
                                    <Setter.Value><SolidColorBrush Color="#C7D2FE"/></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ Header Bar (Stitch style) ============ -->
        <Border Grid.Row="0" Padding="16,0" Height="48">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource HeaderBg}"/>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Logo icon -->
                    <Border Background="{StaticResource PrimaryBrush}" CornerRadius="5"
                            Width="26" Height="26" Margin="0,0,10,0">
                        <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="AgentHub" Foreground="White" FontSize="16" 
                               FontWeight="Bold" VerticalAlignment="Center"/>
                    <!-- Version badge -->
                    <Border Margin="10,0,0,0" CornerRadius="4" Padding="7,2"
                            VerticalAlignment="Center"
                            BorderThickness="1">
                        <Border.Background>
                            <SolidColorBrush Color="#6467F2" Opacity="0.15"/>
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#6467F2" Opacity="0.3"/>
                        </Border.BorderBrush>
                        <TextBlock Text="V1.0" FontSize="9.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WindowControlButton}" 
                            Content="—" FontSize="10"
                            Click="OnMinimizeWindow"/>
                    <Button x:Name="MaximizeBtn" 
                            Style="{StaticResource WindowControlButton}" 
                            Content="⬜" FontSize="10"
                            Click="OnMaximizeRestoreWindow"/>
                    <Button Style="{StaticResource WindowCloseButton}" 
                            Content="✕" FontSize="14"
                            Click="OnCloseWindow"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Main Content ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======= Column 1: AI Editors Sidebar ======= -->
            <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Border.Background>
                    <SolidColorBrush Color="{StaticResource SidebarBg}"/>
                </Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title (uppercase like Stitch) -->
                    <TextBlock Grid.Row="0" Text="A I   E D I T O R S" 
                               FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextLightBrush}"
                               Margin="16,16,16,10"/>

                    <!-- Editor List -->
                    <ListBox Grid.Row="1"
                             x:Name="EditorsListBox" 
                             ItemsSource="{Binding Editors}"
                             BorderThickness="0" Background="Transparent"
                             SelectionMode="Single" Padding="8,0"
                             ItemContainerStyle="{StaticResource EditorListBoxItem}"
                             SelectionChanged="OnEditorChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Icon in circle -->
                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" 
                                               FontSize="20" VerticalAlignment="Center" 
                                               Margin="0,0,10,0"/>
                                    <!-- Name + Status -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDarkBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="10" Margin="0,1,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="Auto-detected"/>
                                                    <Setter Property="Foreground" Value="{StaticResource TextLightBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUserDefined}" Value="True">
                                                            <Setter Property="Text" Value="User-added"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsDetected}" Value="True">
                                                            <Setter Property="Text" Value="Active"/>
                                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Bottom: Add + Remove Buttons -->
                    <StackPanel Grid.Row="2" Margin="12,0,12,12">
                        <Button x:Name="RemoveEditorBtn"
                                Content="🗑️ 移除选中" 
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,0,8"
                                HorizontalAlignment="Stretch"
                                Click="OnRemoveEditor"
                                Visibility="Collapsed"/>
                        <Button Content="＋  Add Editor" 
                                Style="{StaticResource DashedButton}"
                                HorizontalAlignment="Stretch"
                                Click="OnAddEditor"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ======= Column 2: Explorer Tree ======= -->
            <Border Grid.Column="1" Background="White" 
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header with refresh/filter buttons (Stitch style) -->
                    <Border Grid.Row="0" Padding="14,10"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Background="White">
                        <Grid>
                            <TextBlock x:Name="CenterHeaderText" Text="Explorer" 
                                       FontWeight="Bold" FontSize="13.5"
                                       Foreground="{StaticResource TextDarkBrush}"
                                       VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="🔄" FontSize="12" Padding="4,2" 
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextLightBrush}"
                                        Cursor="Hand" ToolTip="刷新"
                                        Click="OnRefreshEditor"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- TreeView -->
                    <TreeView Grid.Row="1" x:Name="ItemsTreeView"
                              BorderThickness="0" Background="Transparent"
                              Padding="8,4"
                              SelectedItemChanged="OnTreeViewSelectedItemChanged">
                        <TreeViewItem Header="📡  MCP Servers" 
                                      x:Name="McpServersNode"
                                      FontSize="13" FontWeight="SemiBold"
                                      Foreground="{StaticResource TextDarkBrush}"
                                      Margin="0,4,0,4" IsExpanded="True"/>
                        <TreeViewItem Header="🧩  Skills" 
                                      x:Name="SkillsNode"
                                      FontSize="13" FontWeight="SemiBold"
                                      Foreground="{StaticResource TextDarkBrush}"
                                      Margin="0,4,0,4" IsExpanded="True"/>
                    </TreeView>
                </Grid>
            </Border>

            <!-- ======= Column 3: Detail Panel ======= -->
            <Border Grid.Column="2" Background="White">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="DetailsPanel">
                        <TextBlock Text="👈 请选择一个 AI 编辑器开始浏览" 
                                   Foreground="{StaticResource TextLightBrush}" 
                                   FontSize="14" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" 
                                   Margin="40,120"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ Status Bar Footer (Stitch style) ============ -->
        <Border Grid.Row="2" Height="24" Padding="12,0">
            <Border.Background>
                <SolidColorBrush Color="{StaticResource PrimaryColor}"/>
            </Border.Background>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="#86EFAC" FontSize="8" 
                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock Text="System Ready" Foreground="White" FontSize="10.5" 
                               Opacity="0.9" VerticalAlignment="Center"/>
                    <TextBlock Text="│" Foreground="White" Opacity="0.3" 
                               Margin="10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="☁ MCP Sync: Active" Foreground="White" FontSize="10.5"
                               Opacity="0.9" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="◇ v1.0.0" Foreground="White" FontSize="10.5"
                               Opacity="0.9" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
