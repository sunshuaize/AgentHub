<Window x:Class="AgentHub.AddEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="添加 AI 编辑器" 
        Height="500" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        Background="White">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid Margin="28,20,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Dialog Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <TextBlock Text="⊕" FontSize="16" Foreground="#6467F2" 
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="添加 AI 编辑器" FontSize="16" FontWeight="Bold" 
                       Foreground="#1E293B" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Editor Name -->
        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Text="编辑器名称" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FieldInput}">
                <TextBox.ToolTip>例如: Cursor, VS Code</TextBox.ToolTip>
            </TextBox>
        </StackPanel>

        <!-- Config Path -->
        <StackPanel Grid.Row="2" Margin="0,0,0,16">
            <TextBlock Text="配置文件路径" Style="{StaticResource FieldLabel}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Grid.Column="0" Style="{StaticResource FieldInput}"/>
                <Button Grid.Column="1" Content="浏览..." 
                        Padding="14,9" Margin="8,0,0,0"
                        FontSize="12" Background="#F8FAFC"
                        BorderBrush="#E2E8F0" Foreground="#64748B"
                        Cursor="Hand" Click="OnBrowse">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </StackPanel>

        <!-- MCP Key -->
        <StackPanel Grid.Row="3" Margin="0,0,0,16">
            <TextBlock Text="MCP 配置键名 (Key)" Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="McpKeyBox" Padding="12,9" FontSize="13" 
                      IsEditable="True" SelectedIndex="0" 
                      BorderBrush="#E2E8F0" Foreground="#1E293B">
                <ComboBoxItem Content="mcpServers"/>
                <ComboBoxItem Content="mcp"/>
            </ComboBox>
        </StackPanel>

        <!-- Icon -->
        <StackPanel Grid.Row="4" Margin="0,0,0,16">
            <TextBlock Text="图标 (Emoji 或 图标代码)" Style="{StaticResource FieldLabel}"/>
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="IconBox" Text="🔧" Style="{StaticResource FieldInput}" 
                         MaxLength="4" Width="60" TextAlignment="Center" FontSize="20"/>
                <TextBlock Text="该图标将显示在侧边栏和编辑器列表中" FontSize="11" 
                           Foreground="#94A3B8" VerticalAlignment="Center" 
                           Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="28,9" Margin="0,0,10,0"
                    Click="OnCancel" IsCancel="True" FontSize="13"
                    Background="White" BorderBrush="#E2E8F0" 
                    Foreground="#64748B" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="确定" Padding="28,9"
                    Click="OnOk" IsDefault="True" FontSize="13" FontWeight="SemiBold"
                    Background="#6467F2" Foreground="White" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</Window>
